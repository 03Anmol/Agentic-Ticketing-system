GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional - email notifications (FR-8). This is YOUR OWN email account's
# SMTP credentials (e.g. a Gmail "app password", not your real Gmail
# password, and never an IRCTC/platform password). Leave blank to skip
# email and use in-app notifications only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_EMAIL_TO=where-to-send-notifications@example.com

# Optional - real train numbers/names from India's open government data
# portal (data.gov.in), replacing the fictional catalog in mock_data.py.
# 1. Free key: https://api.data.gov.in/signup/
# 2. Find the resource ID on the dataset's page (its "API" tab shows it):
#    https://www.data.gov.in/catalog/indian-railways-train-time-table
# Leave blank to keep using the static fallback catalog - see the docstring
# in agents/real_train_catalog.py for why this can't be pre-filled here.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_TRAIN_RESOURCE_ID=
